# ============================================================
# Wikipedia — Environment Variables
# ============================================================

# --- Redpanda (Message Broker) ---
# Internal Redpanda broker for Docker services.
REDPANDA_BROKER=redpanda:9092
# Kafka port exposed to the host.
REDPANDA_EXTERNAL_PORT=19092
# Redpanda Admin API port.
REDPANDA_ADMIN_PORT=9644

# --- Spark ---
# Spark Master port (scheduler).
SPARK_MASTER_PORT=7077
# Spark Master Web UI port.
SPARK_MASTER_WEBUI_PORT=8080
# Spark Worker Web UI port.
SPARK_WORKER_WEBUI_PORT=8081
# Memory assigned to Spark Worker.
SPARK_WORKER_MEMORY=8G
# Number of cores assigned to Spark Worker.
SPARK_WORKER_CORES=4

# --- MinIO (S3-compatible storage) ---
# MinIO root user.
MINIO_ROOT_USER=wikipedia
# MinIO root password.
MINIO_ROOT_PASSWORD=wikipedia123
# MinIO S3 API port.
MINIO_PORT=9000
# MinIO web console port.
MINIO_CONSOLE_PORT=9001
# Main lakehouse bucket.
MINIO_BUCKET=lakehouse

# --- MongoDB ---
# Initial MongoDB admin user.
MONGO_INITDB_ROOT_USERNAME=wikipedia
# Initial MongoDB admin password.
MONGO_INITDB_ROOT_PASSWORD=wikipedia123
# MongoDB port exposed to the host.
MONGO_PORT=27017
# Database used by the project.
MONGO_DATABASE=wikipedia
# Collection where news are published.
MONGO_COLLECTION=news

# --- Ollama (AI Core) ---
# Ollama HTTP port.
OLLAMA_PORT=11434
# LLM model used for news drafting.
OLLAMA_MODEL=qwen3:8b

# --- Kafka Topic ---
# Kafka/Redpanda topic for pure Wikipedia raw events.
KAFKA_TOPIC_RAW=wiki-raw

# --- Spark Silver (Phase 3) ---
# Silver microbatch frequency.
SILVER_TRIGGER_INTERVAL=30 seconds
# Conservative regex to detect reverts.
SILVER_REVERT_SIGNAL_REGEX=.*\b(undid revision|revert(?:ed|ing)? .*edit(?:s)? by)\b.*
# Maturation minutes before considering an event publishable.
SILVER_EVENT_HOLD_MINUTES=5
# Historical window to detect topics.
SILVER_TOPIC_LOOKBACK_MINUTES=45
# Max candidate topics per batch.
SILVER_TOPIC_TOP_N=8
# Minimum frequency to consider a topic.
SILVER_TOPIC_MIN_DOC_FREQ=6
# Number of samples per topic sent to Gold.
SILVER_TOPIC_SAMPLE_SIZE=10
# Minimum token length in topic detection.
SILVER_TOKEN_MIN_LEN=4

# --- Spark Gold (Phase 4) ---
# Gold microbatch frequency.
GOLD_TRIGGER_INTERVAL=30 seconds
# Initial Delta version when starting Gold.
GOLD_STARTING_VERSION=latest
# Max topics/events processed per batch in Gold.
GOLD_MAX_EVENTS_PER_BATCH=30
# Ollama call timeout (seconds).
OLLAMA_TIMEOUT_SECONDS=60
# Minimum token length for similarity.
GOLD_TOKEN_MIN_LEN=4
# Stopwords for deduplication/similarity in Gold.
GOLD_TOPIC_STOPWORDS=wikipedia,article,file,edit,updated,update,category,page,using,added,user,minor,bot,with,from,that,this,para,como,donde,sobre,con,from,the,and,for,are,was,you,your,http,https,www,wiki
# Lookback hours for duplicate comparisons.
GOLD_DEDUP_LOOKBACK_HOURS=6
# Max historical candidates for dedup.
GOLD_DEDUP_MAX_CANDIDATES=400
# Headline similarity threshold for dedup.
GOLD_HEADLINE_SIM_THRESHOLD=0.92
# Summary similarity threshold for dedup.
GOLD_SUMMARY_SIM_THRESHOLD=0.90
# Token Jaccard threshold for dedup.
GOLD_TOKEN_JACCARD_THRESHOLD=0.82
# Minimum minutes between updates of the same story.
GOLD_MIN_UPDATE_INTERVAL_MINUTES=25
# Minimum volume delta to publish an update.
GOLD_MIN_TOPIC_COUNT_DELTA=3
# Hours to close live stories without activity.
GOLD_STORY_STALE_HOURS=12

# --- Spark Serving (Phase 5) ---
# Serving to MongoDB microbatch frequency.
SERVING_TRIGGER_INTERVAL=30 seconds
# Initial Delta version when starting serving.
SERVING_STARTING_VERSION=latest
# Maximum documents per MongoDB bulk write (larger batches are split into chunks).
SERVING_BATCH_LIMIT=200
# If true, performs initial load from Gold upon startup.
SERVING_BOOTSTRAP_ENABLED=true
# Maximum records for initial bootstrap.
SERVING_BOOTSTRAP_MAX_RECORDS=5000

# --- Phase 6 (Web + Observability) ---
# FastAPI web/API public port.
NEWSROOM_API_PORT=8085
# Prometheus port.
PROMETHEUS_PORT=9090
# Grafana port.
GRAFANA_PORT=3000
# Node Exporter port.
NODE_EXPORTER_PORT=9100
# cAdvisor port.
CADVISOR_PORT=8088
# DCGM Exporter port (NVIDIA GPU).
DCGM_EXPORTER_PORT=9400
# Initial Grafana admin user.
GRAFANA_ADMIN_USER=admin
# Initial Grafana admin password.
GRAFANA_ADMIN_PASSWORD=admin123

# --- Wikipedia SSE Producer (Phase 1) ---
# Wikimedia recent changes SSE stream URL.
WIKI_SSE_URL=https://stream.wikimedia.org/v2/stream/recentchange
# User-Agent sent to Wikimedia from the producer.
WIKI_USER_AGENT=wiki-stream-mlops/1.0 (https://github.com/JesusJimenez01/wiki-stream-mlops)
# Wait before reconnecting to SSE after an error (seconds).
PRODUCER_RECONNECT_DELAY=5
# Frequency of producer throughput logs.
PRODUCER_LOG_EVERY_N=100
# Producer log level.
LOG_LEVEL=INFO
