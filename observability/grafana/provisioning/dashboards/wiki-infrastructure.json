{
  "uid": "wiki-infrastructure",
  "title": "Wikipedia - Infrastructure",
  "tags": ["wikipedia", "hardware", "gpu", "host"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "GPU util. (%)",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_GPU_UTIL)"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "type": "stat",
      "title": "VRAM used (MiB)",
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_FB_USED)"}],
      "fieldConfig": {"defaults": {"unit": "decbytes", "decimals": 0}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "type": "timeseries",
      "title": "Host CPU (%)",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "host cpu"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Host RAM (%)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))", "legendFormat": "host ram"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "CPU per service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"spark-bronze|spark-silver|spark-gold|producer|redpanda|ollama|newsroom-api\"}[5m]))", "legendFormat": "{{container_label_com_docker_compose_service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3}}
    },
    {
      "type": "timeseries",
      "title": "RAM per service",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"spark-bronze|spark-silver|spark-gold|producer|redpanda|ollama|newsroom-api\"})", "legendFormat": "{{container_label_com_docker_compose_service}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "GPU usage over time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "gpu util"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "VRAM used over time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_FB_USED) * 1048576", "legendFormat": "vram used"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "GPU temperature",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_GPU_TEMP)", "legendFormat": "gpu temp"}],
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "VRAM free",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_FB_FREE) * 1048576", "legendFormat": "vram free"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "GPU memory copy util",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max(DCGM_FI_DEV_MEM_COPY_UTIL)", "legendFormat": "mem copy util"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}
    }
  ]
}
