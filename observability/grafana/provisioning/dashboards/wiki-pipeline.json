{
  "uid": "wiki-pipeline",
  "title": "Wikipedia - Data Pipeline",
  "tags": ["wikipedia", "pipeline", "spark", "redpanda", "minio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Inferencia OK (%)",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "wiki_inference_success_ratio * 100"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "type": "timeseries",
      "title": "Redpanda throughput (bytes/s)",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(redpanda_rpc_received_bytes{redpanda_server=\"kafka\"}[5m]))", "legendFormat": "produce"},
        {"refId": "B", "expr": "sum(rate(redpanda_rpc_sent_bytes{redpanda_server=\"kafka\"}[5m]))", "legendFormat": "consume"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Spark input vs processing rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (job) ({job=~\"spark-(bronze|silver|gold)-driver\", __name__=~\".*inputRate.*\"})", "legendFormat": "{{job}} input"},
        {"refId": "B", "expr": "sum by (job) ({job=~\"spark-(bronze|silver|gold)-driver\", __name__=~\".*processingRate.*\"})", "legendFormat": "{{job}} processing"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Spark processing deficit",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "clamp_min(sum by (job) ({job=~\"spark-(bronze|silver|gold)-driver\", __name__=~\".*inputRate.*\"}) - sum by (job) ({job=~\"spark-(bronze|silver|gold)-driver\", __name__=~\".*processingRate.*\"}), 0)", "legendFormat": "{{job}} deficit"}],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Pipeline storage footprint",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "wiki_project_storage_bytes", "legendFormat": "project total"},
        {"refId": "B", "expr": "wiki_bronze_storage_bytes", "legendFormat": "bronze"},
        {"refId": "C", "expr": "wiki_silver_storage_bytes", "legendFormat": "silver"},
        {"refId": "D", "expr": "wiki_gold_storage_bytes", "legendFormat": "gold"},
        {"refId": "E", "expr": "wiki_mongodb_storage_bytes", "legendFormat": "mongodb"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}
    },
    {
      "type": "timeseries",
      "title": "Lakehouse total",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "wiki_lakehouse_storage_bytes", "legendFormat": "lakehouse"},
        {"refId": "B", "expr": "wiki_bronze_storage_bytes + wiki_silver_storage_bytes + wiki_gold_storage_bytes", "legendFormat": "bronze+silver+gold"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}
    }
  ]
}
